---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  /** Un texto, o una lista de líneas (se separan con un salto de línea) */
  kicker: string | string[];
  titulo: string;
  subtitulo: string;
  etiquetas?: string[];
  boton: { texto: string; href: string };
  imagen: ImageMetadata;
  alt: string;
  /** Primera sección: el kicker es el <h1> de la página y la imagen carga con prioridad */
  principal?: boolean;
}
const { id, kicker, titulo, subtitulo, etiquetas = [], boton, imagen, alt, principal = false } = Astro.props;
const Kicker = principal ? 'h1' : 'p';
const lineasKicker = Array.isArray(kicker) ? kicker : [kicker];
---
<section id={id} class="hero">
  <Image
    src={imagen}
    alt={alt}
    class="hero__bg"
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    format="webp"
    quality={75}
    loading={principal ? 'eager' : 'lazy'}
    fetchpriority={principal ? 'high' : 'auto'}
  />
  <div class="hero__contenido">
    <Kicker class="hero__kicker">
      {lineasKicker.map((linea, i) => <>{i > 0 && <br />}{linea}</>)}
    </Kicker>
    <h2 class="hero__titulo">{titulo}</h2>
    <p class="hero__subtitulo">{subtitulo}</p>
    {etiquetas.length > 0 && (
      <ul class="hero__etiquetas">
        {etiquetas.map((e) => <li>{e}</li>)}
      </ul>
    )}
    <a class="boton" href={boton.href}>{boton.texto}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* 100% del contenedor con scroll (.snap-container), no de la pantalla: siempre calza exacto.
       Es min-height para que, si el texto no cabe en un teléfono pequeño, la sección crezca. */
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-snap-align: start;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Degradados en los bordes: negro → transparente, arriba (hacia abajo) y abajo (hacia arriba).
     Entre dos secciones las fotos se funden con una franja negra. Alto de cada borde: 48px. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, #000, rgb(0 0 0 / 0)) top / 100% 48px no-repeat,
      linear-gradient(to top, #000, rgb(0 0 0 / 0)) bottom / 100% 48px no-repeat;
  }

  /* Oscurecimiento: negro → transparente, de izquierda a derecha hasta la mitad */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.85) 0%, rgb(0 0 0 / 0) 65%);
  }

  .hero__contenido {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 580px;
    margin-left: var(--margen-x);
  }

  .hero__kicker {
    font-family: var(--fuente-titulos);
    font-weight: 600;
    font-size: 30px;
    color: var(--orange);
    filter: drop-shadow(3px 3px 1px rgb(0 0 0 / .73));
  }
  .hero__titulo {
    font-family: var(--fuente-titulos);
    font-weight: 700;
    font-size: 52px;
    line-height: 60px;
    color: #fff;
    filter: drop-shadow(3px 3px 1px rgb(0 0 0 / .75));
  }
  .hero__subtitulo {
    font-family: var(--fuente-titulos);
    font-weight: 400;
    font-size: 24px;
    line-height: 44px;
    color: #fff;
    filter: drop-shadow(3px 3px 1px rgb(0 0 0 / .75));
  }

  .hero__etiquetas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
  }
  .hero__etiquetas li {
    padding: 8px 14px;
    border: 1px solid #fff;
    border-radius: 8px;
    font-size: 16px;
  }

  /* Desktop: los bordes exteriores (arriba de la primera sección, abajo de la última) no llevan
     degradado; solo queda el del medio, donde se unen las dos fotos. */
  @media (min-width: 768px) {
    .hero:first-child::before {
      background: linear-gradient(to top, #000, rgb(0 0 0 / 0)) bottom / 100% 48px no-repeat;
    }
    .hero:last-child::before {
      background: linear-gradient(to bottom, #000, rgb(0 0 0 / 0)) top / 100% 48px no-repeat;
    }
  }

  /* Móvil: el oscurecimiento cubre toda la pantalla y el contenido va a lo ancho */
  @media (max-width: 767px) {
    .hero::after { background: rgb(0 0 0 / .6); }

    /* Todo centrado en móvil: align-items centra los bloques (botón, etiquetas) y
       text-align centra las líneas de texto (lo heredan kicker, título y subtítulo). */
    .hero__contenido {
      margin-right: var(--margen-x);
      max-width: none;
      padding-top: 80px;
      align-items: center;
      text-align: center;
    }
    .hero__kicker { font-size: 22px; }
    .hero__titulo { font-size: 34px; line-height: 42px; }
    .hero__subtitulo { font-size: 18px; line-height: 30px; }
    .hero__etiquetas { justify-content: center; }
  }
</style>
