---
import logo from '../assets/logo.svg';
---
<header class="header">
  <span class="header__vacio" aria-hidden="true"></span>
  <a class="header__logo" href="/" aria-label="Cafetonato, ir al inicio">
    <img src={logo.src} alt="Cafetonato" width="64" height="60" />
  </a>
  <nav class="header__nav" aria-label="Principal">
    <a href="/academia">Academia</a>
    <a href="/tienda">Tienda</a>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: grid;
    /* 3 columnas iguales: vacío | logo | menú → el logo queda siempre centrado */
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    padding: 12px var(--margen-x);
  }
  .header__logo img {
    display: block;
    height: 60px;
    width: auto;
    /* El logo original es de color; este filtro lo vuelve blanco */
    filter: brightness(0) invert(1);
  }
  .header__nav {
    display: flex;
    justify-content: flex-end;
    gap: 32px;
    padding-top: 6px;
  }
  .header__nav a {
    color: var(--blanco);
    text-decoration: none;
    font-size: 18px;
    text-shadow: 1px 1px 2px rgb(0 0 0 / .6);
  }
  .header__nav a:hover { color: var(--orange); }

  @media (max-width: 767px) {
    .header__nav { gap: 16px; }
    .header__nav a { font-size: 15px; }
    .header__logo img { height: 48px; }
  }
</style>
