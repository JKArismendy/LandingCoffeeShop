---
import logo from '../assets/logo.svg';
---
<header class="header">
  <a class="header__logo" href="/" aria-label="Cafetonato, ir al inicio">
    <img src={logo.src} alt="Cafetonato" width="64" height="60" />
  </a>

  <!-- Botón hamburguesa: solo visible en móvil -->
  <button
    class="header__toggle"
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="menu-principal"
  >
    <span></span><span></span><span></span>
  </button>

  <nav id="menu-principal" class="header__nav" aria-label="Principal">
    <a href="/academia">Academia</a>
    <a href="/tienda">Tienda</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.header__toggle')!;
  const links = header.querySelectorAll<HTMLAnchorElement>('.header__nav a');

  function setAbierto(abierto: boolean) {
    header.classList.toggle('abierto', abierto);
    toggle.setAttribute('aria-expanded', String(abierto));
    toggle.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  }

  toggle.addEventListener('click', () => setAbierto(!header.classList.contains('abierto')));
  links.forEach((a) => a.addEventListener('click', () => setAbierto(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setAbierto(false));
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    justify-content: space-between; /* logo a la izquierda, menú a la derecha */
    align-items: center;
    padding: 30px calc(var(--margen-x) + 35px); /* mismo margen lateral que el contenido del hero */
  }

  .header__logo img {
    display: block;
    height: 60px;
    width: auto;
    /* El logo original es de color; este filtro lo vuelve blanco */
    filter: brightness(0) invert(1);
  }

  .header__nav {
    display: flex;
    gap: 32px;
  }
  .header__nav a {
    color: var(--blanco);
    text-decoration: none;
    font-size: 18px;
    text-shadow: 1px 1px 2px rgb(0 0 0 / .6);
  }
  .header__nav a:hover { color: var(--orange); }

  /* El botón no existe en desktop */
  .header__toggle { display: none; }

  @media (max-width: 767px) {
    .header__logo img { height: 48px; }

    .header__toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
      width: 44px; /* tamaño mínimo cómodo para el dedo */
      height: 44px;
      padding: 10px;
      background: none;
      border: 0;
      cursor: pointer;
    }
    .header__toggle span {
      display: block;
      height: 2px;
      background: var(--blanco);
      border-radius: 2px;
      transition: transform .25s ease, opacity .25s ease;
    }
    .header__toggle:focus-visible { outline: 2px solid var(--blanco); outline-offset: 2px; }

    /* Menú desplegable: panel bajo la barra, oculto hasta que se abre */
    .header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: rgb(0, 0, 0, 0.582);
      padding: 8px var(--margen-x) 16px;
    }
    .header__nav a { font-size: 20px; padding: 14px 0; text-shadow: none; }

    .header.abierto { background: rgba(0, 0, 0, 0.582); }
    .header.abierto .header__nav { display: flex; }

    /* Las 3 rayas se convierten en una X */
    .header.abierto .header__toggle span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .header.abierto .header__toggle span:nth-child(2) { opacity: 0; }
    .header.abierto .header__toggle span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
  }
</style>
